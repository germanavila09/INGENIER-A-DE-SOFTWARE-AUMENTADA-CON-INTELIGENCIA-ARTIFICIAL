# Copia este archivo como .env y ajusta los valores. .env NO se sube a GitHub.

# --- Bucket ---
GOOGLE_CLOUD_PROJECT=servi-modelos-ia-dev
GCS_BUCKET=adk_ing
# Prefijo opcional para trabajar solo con una carpeta del bucket (ej. documentos/)
GCS_PREFIX=
# Carpeta local para `adk-ing sync`
LOCAL_DATA_DIR=data/raw

# --- Documentos del agente ---
# Para probar sin el bucket: el agente lee de esta carpeta (ej. docs_ejemplo). Vacío = bucket.
DOCS_LOCAL_DIR=
# Cada cuántos segundos vuelve a revisar el bucket en busca de documentos nuevos
INDICE_TTL_SEG=30
# Tamaño máximo (MB) de un documento para indexarlo
DOCS_MAX_MB=50

# --- Modelo (Gemini en Vertex AI) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash

# --- ADK Web (python adk_web.py) ---
ADK_PORT=8000
# Guardar en el bucket los archivos que generen las sesiones (requiere permiso de escritura).
# Vacío = carpeta local agents/agente_bucket/.adk
ADK_ARTIFACT_URI=
# Sesiones: vacío = SQLite en .adk; memory:// = en memoria (útil si el repo está en Google Drive)
ADK_SESSION_URI=

# --- Orquestador multiagente de historias (orquestador_hu) ---
# Entrada (solo lectura). Reconoce projects/<carpeta>/, <carpeta>/ y archivos sueltos agrupados
# por el prefijo del nombre (p. ej. "SERVI _ SINCHI __ ..." → SERVI_SINCHI). Para probar: ejemplos/projects
HU_INPUT_URI=gs://adk_ing/
# Resultados, estado y auditoría (separado de la entrada). Local o gs://adk_ing_resultados
HU_RESULTS_URI=salidas_hu
# Umbrales y límites HITL
HU_CONFIDENCE_AUTO=0.85
HU_CONFIDENCE_REVIEW=0.60
HU_MAX_HISTORIAS_POR_EJECUCION=10
HU_MAX_REANALISIS=2
# Generación de historias para proyectos que solo tienen actas, notas o propuestas
HU_MAX_HISTORIAS_GENERADAS=12
HU_GENERADAS_REQUIEREN_APROBACION=false

# Solo si usas una cuenta de servicio en lugar de `gcloud auth application-default login`:
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/llave.json
