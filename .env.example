# Copiar a .env y ajustar. Nunca commitear .env.
DATABASE_URL=postgresql+psycopg://spb:spb@localhost:5432/spb
SESSION_SECRET=cambiar-por-un-valor-largo-aleatorio
# Opcional: el sistema hace POST aquí cuando una HU entra a refinamiento
ADK_WEBHOOK_URL=
# Usado sólo por scripts/seed.py
SEED_ADMIN_EMAIL=admin@spb.local
SEED_ADMIN_PASSWORD=cambiar-me-ya

# --- Agentes IA ---
# none (desactivado) | stub (sin LLM, para pruebas) | adk (Gemini con Google ADK)
AGENT_PROVIDER=none
# Gemini Pro: confirma el id exacto con `python scripts/try_agent.py --list-models`
AGENT_MODEL=gemini-3.1-pro-preview
# Clave de Gemini API / Google AI Studio (cuenta empresarial). Nunca la commitees.
GOOGLE_API_KEY=
# background (en segundo plano) | inline (espera el resultado; útil para pruebas)
AGENT_EXECUTION=background
# true: al pasar una HU a en_refinamiento el agente interno la refina
AGENT_AUTO_REFINE=false
AGENT_MAX_DOC_CHARS=200000
# Fuente de documentos: UNA de las dos, nunca ambas.
#   folder → AGENT_DOCS_DIR/<KEY>/ (por defecto). Deja vacías las variables de gcs.
#   gcs    → gs://AGENT_DOCS_BUCKET/AGENT_DOCS_PREFIX/<KEY>/. AGENT_DOCS_BUCKET es obligatoria.
# Una configuración que mezcla ambas hace que la app no arranque, con un mensaje claro.
AGENT_DOCS_SOURCE=folder
# --- solo gcs ---
AGENT_DOCS_BUCKET=
AGENT_DOCS_PREFIX=
# Opcional: proyecto de GCP del cliente de Storage (si no, el de las credenciales)
GCP_PROJECT=
# Credenciales para gcs: Application Default Credentials o una cuenta de servicio (rol storage.objectViewer)
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
# Opcional: precio por millón de tokens para estimar el costo en agent_runs
AGENT_PRICE_IN_PER_1M=
AGENT_PRICE_OUT_PER_1M=

# --- Modo local (recomendado): Postgres en Docker + carpeta documents/<CLAVE>/ + Gemini con API key ---
# Clave en https://aistudio.google.com/apikey (no requiere permisos de GCP). Con docker-compose.yml solo.
# AGENT_PROVIDER=adk
# AGENT_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=tu-clave
# GOOGLE_GENAI_USE_VERTEXAI=false
# AGENT_DOCS_SOURCE=folder
# AGENT_PRICE_IN_PER_1M=0.30
# AGENT_PRICE_OUT_PER_1M=2.50
# (deja vacías AGENT_DOCS_BUCKET, AGENT_DOCS_PREFIX, AGENT_DOCS_MAP y GCP_PROJECT)

# --- Revisión humana (HITL) ---
# Confianza mínima de los agentes: >= AUTO sin observación; entre REVIEW y AUTO nivel 1; < REVIEW nivel 2.
# HITL_CONFIDENCE_AUTO=0.85
# HITL_CONFIDENCE_REVIEW=0.60
# Revisar de nuevo una HU tras refinarla por «Pedir cambios» (true) / revisar al generar HU (false)
# HITL_REVIEW_AFTER_REFINE=true
# HITL_REVIEW_GENERATED=false

# --- GCP: bucket + Gemini en Vertex AI (con docker-compose.gcp.yml) ---
# Credenciales: `gcloud auth application-default login`; docker-compose.gcp.yml monta ese archivo.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mi-proyecto-gcp
# GOOGLE_CLOUD_LOCATION=us-central1
# AGENT_PROVIDER=adk
# AGENT_MODEL=gemini-2.5-flash
# AGENT_DOCS_SOURCE=gcs
# AGENT_DOCS_BUCKET=mi-bucket
# AGENT_DOCS_PREFIX=spb
# Bucket con su propia organización: CLAVE=prefijo (carpeta/ o comienzo del nombre de archivos sueltos)
# AGENT_DOCS_MAP=SINCHI=SERVI _ SINCHI __;DOCS=documentos/
# GCP_PROJECT=mi-proyecto-gcp
